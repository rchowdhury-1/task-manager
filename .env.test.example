# Copy to .env.test for local integration test runs.
# Must be a disposable local Postgres — the integration suite truncates
# tables between test files and globalSetup refuses to run against
# anything that isn't localhost/127.0.0.1 (see helpers/globalSetup.ts).
#
# Create it once:
#   psql -h localhost -U postgres -c "CREATE DATABASE personal_os_test"
DATABASE_URL=postgresql://localhost:5432/personal_os_test
JWT_SECRET=integration-test-secret
