# Copy to .env.local for local development.
# This is a single Next.js 14 App Router monolith — there is no
# separate server/client split (render.yaml documented one; it's gone).

# --- Database (Neon Postgres) ---
# Local dev: a plain Postgres connection string is fine.
# Production: point this at Neon's *pooled* (PgBouncer) endpoint —
# `...-pooler.neon.tech` — so concurrent serverless instances don't
# exhaust the underlying connection limit.
DATABASE_URL=postgresql://user:pass@localhost:5432/personal_os_dev

# Production only. Neon's *direct* (unpooled) endpoint, used exclusively
# by lib/db/migrate.ts for DDL — PgBouncer's transaction-pooling mode
# doesn't support all session-level operations migrations may need.
# Falls back to DATABASE_URL if unset (fine for local dev).
# DATABASE_URL_UNPOOLED=postgresql://user:pass@ep-xxxx.region.aws.neon.tech/db

# Optional: pg.Pool size per serverless instance. Default 5.
# PG_POOL_MAX=5

# --- Auth ---
JWT_SECRET=your-dev-jwt-secret-change-in-production

# --- Cron ---
# Authenticates Vercel Cron -> /api/cron/{morning,evening}. Required in
# production (auth fails closed if unset); optional for local dev since
# the cron routes are only invoked by Vercel's scheduler.
CRON_SECRET=your-dev-cron-secret

# --- AI (OpenAI gpt-4o-mini agent) ---
# Omit locally to leave the AI command bar inert in dev.
OPENAI_API_KEY=
AI_PROMPTS_PER_DAY_LIMIT=100

# --- Web Push (VAPID) ---
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
